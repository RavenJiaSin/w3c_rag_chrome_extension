{
    "manifest_version": 3,
    "name": "R.E.A.D.",
    "version": "1.0",
    "description": "基於 RAG 架構的 W3C 標準文件閱讀輔助系統",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "storage",
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "https://www.w3.org/TR/*",
        "https://generativelanguage.googleapis.com/",
        "https://127.0.0.1:5050/"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "W3C AI 助手"
    },
    "content_scripts": [
        {
            "matches": ["https://www.w3.org/TR/*"],
            "exclude_matches": ["https://www.w3.org/TR/"],
            "js": ["content.js"],
            "css": ["content.css"],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
      {
        "resources": [
            "sidebar.html",
            "sidebar.js",
            "marked.min.js",
            "purify.min.js",
            "icons/*.png"
        ],
        "matches": ["<all_urls>"]
      }
    ]
}